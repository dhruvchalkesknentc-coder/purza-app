# Copy to .env (or set these in your host's dashboard). All are optional.
PORT=3000
PURZA_DB=./data/purza.db
CORS_ORIGIN=*
WRITES_PER_MINUTE=60
READS_PER_MINUTE=1200
PAYMENTS_MODE=demo
# Photo check: set ONE of these (Gemini has a free tier)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
IDENTIFY_PER_MINUTE=6
# Copilot: runs on Claude when ANTHROPIC_API_KEY is set, else on GEMINI_API_KEY
ANTHROPIC_AGENT_MODEL=claude-sonnet-5-5
AGENT_PER_MINUTE=15
